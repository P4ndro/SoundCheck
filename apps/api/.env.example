# Copy to .env and fill in values from Neon, Clerk, and Cloudinary dashboards.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Required — Neon pooled connection string (?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Required — Clerk → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Required for /api/webhooks/clerk — Clerk → Webhooks → endpoint signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# Optional until chat uploads — Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
